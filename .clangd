# I think this isn't needed because these flags should be parsed
# from compile commands generated by CMake - testing
# CompileFlags:
#   Add: [-Wall, -Wextra, -Wuninitialized, -Wmaybe-uninitialized, -fno-exceptions]

Diagnostics:
  ClangTidy:
    Add:
      [modernize-*, readability-*, bugprone-*, concurrency-*, thread-safety-*]
