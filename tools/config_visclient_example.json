#!/usr/bin/env python3
"""
Configuration file template for launch_with_monitor.py
Useful for repeatable setups (e.g., VISAClient with server + client)
"""

# Save as: config_visclient.json
# Usage: python3 launch_with_monitor.py --config config_visclient.json

[
  {
    "binary": "python3",
    "platform_name": "VISAClient-server",
    "process_type": "server",
    "startup_delay": 0,
    "args": [
      "lib/VISAClient/pyvisa-grpc/server/pyvisa_grpc_server.py"
    ]
  },
  {
    "binary": "./build/examples/VISAClient/main",
    "platform_name": "VISAClient-client",
    "process_type": "client",
    "startup_delay": 2.0,
    "args": []
  }
]
